# Copy to .env (never commit .env) and adjust.

# Subdomain Caddy serves the API on. Its DNS A/AAAA records must point to this VPS.
API_DOMAIN=api.glyph-pdf.com

# The frontend's public URL(s), comma-separated. The browser only talks to
# Vercel (which relays /api here), so this is defense in depth, not required.
ALLOWED_ORIGINS=https://glyph-pdf.com,https://www.glyph-pdf.com

# Limits, sized for a 2 vCPU / 4 GB VPS (see docs/DEPLOY.md):
# 3 sandboxes x 512 MB + 800 MB of documents + the API ~= 2.5 GB < BACKEND_MEM_LIMIT.
SANDBOX_MAX_CONCURRENCY=3
SANDBOX_MAX_MEMORY_MB=512
STORE_MAX_MB=800
MAX_DOCUMENTS=400
BACKEND_MEM_LIMIT=3g

MAX_UPLOAD_MB=20
DOCUMENT_TTL_MINUTES=30
